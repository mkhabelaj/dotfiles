# Ghostty — ported from the old Alacritty config. Nord theme, JetBrainsMono.
# Image support: kitty graphics protocol is built in (works in a bare Ghostty
# window/tab). NOTE: it does NOT survive herdr panes — herdr is a multiplexer
# with no image passthrough, same wall as tmux. Run image tools outside herdr.

# Keep xterm-256color for tmux/herdr/ssh compatibility (Ghostty defaults to
# xterm-ghostty, which unknown-terminfo hosts choke on).
term = xterm-256color

font-family = JetBrainsMono Nerd Font Mono
font-size = 12

background-opacity = 0.8
window-decoration = true
window-padding-balance = true
window-width = 100
window-height = 30

# Nord
background = 2E3440
foreground = D8DEE9

# normal
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
# bright
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

cursor-style = underline

# Alacritty save_to_clipboard = true
copy-on-select = clipboard
mouse-hide-while-typing = true

# Alacritty: Shift+Enter sent ESC CR
keybind = shift+enter=text:\x1b\r
